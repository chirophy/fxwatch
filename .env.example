# A single container, directly accessible at http://SERVER_IP:8099.
COMPOSE_FILE=compose.yaml
FXWATCH_BIND_IP=0.0.0.0

# Use your Docker Hub image name here after publishing.
FXWATCH_IMAGE=chirophy/fxwatch:1.3.0

# Optional: fill both or leave both empty. Not passed to the Web child process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

